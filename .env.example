# ==============================================================================
# BeautySchedule - Exemplo de Configuração de Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores conforme o ambiente (Local/VM)
# NUNCA versione o arquivo .env com senhas reais no Git.
# ==============================================================================

# Ambiente da aplicação (development | testing | production)
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# Origens permitidas no CORS (separadas por vírgula; não usar * com credenciais)
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Banco de Dados (Camada de Dados)
# - Para execução local imediata e testes automatizados: DB_ENGINE=sqlite
# - Na VM Ubuntu Linux com MySQL 8.4: altere para DB_ENGINE=mysql
DB_ENGINE=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=beauty_schedule
DB_USER=beauty_user
DB_PASSWORD=ALTERE_ESTA_SENHA_AQUI

# Contexto SaaS (Isolamento de Tenant / Salão da Sessão de Operação)
# Em ambiente multi-salão, o salão é resolvido exclusivamente no servidor.
DEFAULT_SALAO_ID=1
DEFAULT_USUARIO_ID=1
