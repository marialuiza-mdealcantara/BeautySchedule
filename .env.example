# ==============================================================================
# BeautySchedule - Exemplo de Configuração de Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores conforme o ambiente (Local/VM)
# NUNCA versione o arquivo .env com senhas reais no Git.
# ==============================================================================

# Ambiente da aplicação (development | testing | production)
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# Banco de Dados MySQL 8.4 (Camada de Dados)
# Use DB_ENGINE=mysql em produção/VM Ubuntu com MySQL 8.4
# Para desenvolvimento local sem MySQL ativo ou testes, suporta sqlite
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=beauty_schedule
DB_USER=beauty_user
DB_PASSWORD=ALTERE_ESTA_SENHA_AQUI

# Contexto SaaS (Isolamento de Tenant / Salão da Sessão de Operação)
# Em ambiente multi-salão, o salão é resolvido no servidor a partir da sessão/credencial
# do operador autenticado (e nunca aceito livremente do payload do cliente).
DEFAULT_SALAO_ID=1
DEFAULT_USUARIO_ID=1
